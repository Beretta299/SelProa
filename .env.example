# Copy to .env and fill in. .env is gitignored — never commit real values.

# ── models ───────────────────────────────
ANTHROPIC_API_KEY=

# ── database ─────────────────────────────
POSTGRES_USER=pitwall
POSTGRES_PASSWORD=change-me-locally
POSTGRES_DB=pitwall
DATABASE_URL=postgresql+asyncpg://pitwall:change-me-locally@localhost:5432/pitwall

# ── redis ────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ── auth ─────────────────────────────────
JWT_SECRET=generate-with-openssl-rand-hex-32
JWT_ALGORITHM=HS256

# ── limits (chapter 31) ──────────────────
DAILY_SPEND_CEILING_USD=10
MAX_TOOL_ITERATIONS=8
